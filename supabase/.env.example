# Placeholders only. Copy to supabase/.env for local tooling if needed.
# Real keys come from `supabase status` after `supabase start` — never commit them.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=PLACEHOLDER_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER_SUPABASE_SERVICE_ROLE_KEY
PORTAL_ORIGIN=https://admin.hope-tv.site
# Comma-separated browser origins allowed to call Edge Functions (dashboard + optional local dev).
CORS_ALLOWLIST=https://admin.hope-tv.site,https://hope-tv.mostafaazab3024.workers.dev,http://127.0.0.1:5173,http://127.0.0.1:8080
BILLING_PROVIDER=none
ENTITLEMENT_SIGNING_ALG=hmac
ENTITLEMENT_SIGNING_HMAC_SECRET=PLACEHOLDER_ENTITLEMENT_HMAC_SECRET
ENTITLEMENT_SIGNING_KEY_ID=entitlement-dev-1
OFFLINE_LEASE_HOURS=24
TRIAL_DURATION_DAYS=7
DEVICE_LIMIT=3
# Optional: required only if GitHub release assets are in a private repository.
GITHUB_PAT=PLACEHOLDER_GITHUB_CONTENTS_READ_PAT
RELEASE_SIGNING_ALG=ed25519
RELEASE_SIGNING_KEY_ID=release-dev-1
RELEASE_SIGNING_PRIVATE_KEY_PKCS8_B64=PLACEHOLDER_RELEASE_SIGNING_PRIVATE_KEY_PKCS8_B64
# Local dev only — never set in production Edge Functions when using Ed25519:
# RELEASE_SIGNING_HMAC_SECRET=PLACEHOLDER_RELEASE_SIGNING_HMAC_SECRET
DELETION_GRACE_DAYS=14
CRON_SECRET=PLACEHOLDER_CRON_SECRET
